      "case_id": "sequence_chunked",
      "family": "sequence",
      "function_name": "chunked",
      "parameters": ["values", "size"],
      "requirement": "For a positive size, split a list of values into consecutive lists of that size, retaining a shorter final list when needed.",
      "flaw_rationale": "The flawed version stops before a final incomplete chunk, so inputs whose length is not divisible by the chunk size lose values.",
      "correct_path": "cases/sequence_chunked_correct.py",
      "flawed_path": "cases/sequence_chunked_flawed.py",
      "visible_examples": [
        {"check_id": "chunked_even_length", "input": [[1, 2, 3, 4], 2], "expected": [[1, 2], [3, 4]]},
        {"check_id": "chunked_multiple_groups", "input": [["a", "b", "c", "d", "e", "f"], 3], "expected": [["a", "b", "c"], ["d", "e", "f"]]}
      ],
      "contract_checks": [
        {"check_id": "chunked_retains_remainder", "input": [["a", "b", "c", "d", "e"], 2], "expected": [["a", "b"], ["c", "d"], ["e"]], "witness": true},
        {"check_id": "chunked_empty_sequence", "input": [[], 3], "expected": [], "witness": false}
      ]
    },
